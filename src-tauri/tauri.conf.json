{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Rhua ChatGPT Web",
  "mainBinaryName": "Rhua ChatGPT Web",
  "version": "1.0.1",
  "identifier": "ai.rhua.chatgpt",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "rhua-chatgpt-web",
        "width": 1080,
        "minWidth": 360,
        "height": 960,
        "minHeight": 520,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}